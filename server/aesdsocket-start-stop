#!/bin/sh

case "$1" in
    start)
        echo "Starting aesdsocket"
        start-stop-daemon -S \
            -n aesdsocket \
            --exec /usr/bin/aesdsocket \
            -- -d
        ;;

    stop)
        echo "Stopping aesdsocket"
        start-stop-daemon -K \
            -n aesdsocket \
            --signal TERM
        ;;

    restart)
        "$0" stop
        "$0" start
        ;;

    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0